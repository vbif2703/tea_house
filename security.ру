import hashlib
import secrets

ALGORITHM = "sha256"
ITERATIONS = 200000
SALT_SIZE = 16


def hash_password(password):
    salt = secrets.token_hex(SALT_SIZE)
    digest = hashlib.pbkdf2_hmac(ALGORITHM, password.encode("utf-8"), bytes.fromhex(salt), ITERATIONS).hex()
    return f"pbkdf2_{ALGORITHM}${ITERATIONS}${salt}${digest}"


def verify_password(password, stored_hash):
    try:
        scheme, iterations, salt, digest = stored_hash.split("$")
        algorithm = scheme.split("_")[1]
        iterations = int(iterations)
        salt_bytes = bytes.fromhex(salt)
    except (ValueError, IndexError):
        return False
    check = hashlib.pbkdf2_hmac(algorithm, password.encode("utf-8"), salt_bytes, iterations).hex()
    return secrets.compare_digest(check, digest)
