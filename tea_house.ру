    input_login = input("Введи свой логин: ").strip()
    input_password = input("Введи свой пароль: ").strip()
    if input_login not in users_db or not verify_password(input_password, users_db[input_login]["password_hash"]):
        print("Неверный логин или пароль.")
        return
    new_login = input("Введи новое имя пользователя: ").strip()
    new_password = input("Введи новый пароль: ").strip()
    if not new_login or len(new_password) < 4:
        print("Некорректные новые данные.")
        return
    if input_login == ADMIN_LOGIN and new_login != ADMIN_LOGIN:
        print("Логин администратора менять нельзя.")
        return
    if new_login != input_login and new_login in users_db:
        print("Такой логин уже занят.")
        return
    user_data = users_db.pop(input_login)
    user_data["password_hash"] = hash_password(new_password)
    users_db[new_login] = user_data
    execute("DELETE FROM users WHERE login = ?", (input_login,))
    save_user(new_login)
    execute("UPDATE orders SET login = ? WHERE login = ?", (new_login, input_login))
    execute("UPDATE receipts SET login = ? WHERE login = ?", (new_login, input_login))
    for order in active_orders:
        if order["user"] == input_login:
            order["user"] = new_login
    old_file = f"{input_login}{RECEIPT_SUFFIX}"
    new_file = f"{new_login}{RECEIPT_SUFFIX}"
    if old_file != new_file and os.path.exists(old_file):
        os.rename(old_file, new_file)
    print("Данные учетки изменены!")


def delete_user():
    print("\n!!! Перед удалением аккаунта авторизируйтесь в нем !!!")
    input_login = input("Введи свой логин: ").strip()
    input_password = input("Введи свой пароль: ").strip()
    if input_login not in users_db or not verify_password(input_password, users_db[input_login]["password_hash"]):
        print("Неверный логин или пароль.")
        return
    if input_login == ADMIN_LOGIN:
        print("!!! Учетную запись Admin удалить нельзя !!!")
        return
    if input("Вы действительно хотите удалить учетку? (y/n): ").strip().lower() != "y":
        print("Удаление отменено.")
        return
    balance = users_db.pop(input_login)["balance"]
    execute("DELETE FROM users WHERE login = ?", (input_login,))
    execute("DELETE FROM orders WHERE login = ?", (input_login,))
    execute("DELETE FROM receipts WHERE login = ?", (input_login,))
    filename = f"{input_login}{RECEIPT_SUFFIX}"
    if os.path.exists(filename):
        os.remove(filename)
    print(f"Заберите деньги со счета: {balance} руб.")
    time.sleep(1)
    print("Учетка удалена.")


def show_orders(limit=None, with_receipts=False):
    rows = fetch_all("SELECT id, login, section, item, qty, hall, price, status FROM orders ORDER BY rowid DESC")
    total = len(rows)
    if limit is not None:
        rows = rows[:limit]
    if not rows:
        print("Заказов пока нет.")
        return
    print(f"\n--- ЗАКАЗЫ И ЦЕРЕМОНИИ: показано {len(rows)} из {total} ---")
    for number, (oid, user, section, item, qty, hall, price, status) in enumerate(rows, start=1):
        place = f", зал {hall}" if hall else ""
        print(f"{number}. [{oid}] {user}: [{section}] {item} x{qty}{place}, {price} руб. [{status}]")
        if with_receipts:
            receipt = fetch_all("SELECT content FROM receipts WHERE id = ?", (oid,))
            print("-" * 34)
            if receipt:
                print(receipt[0][0])
            else:
                print("Чек еще не сформирован: заказ в работе.")
            print("-" * 34)


