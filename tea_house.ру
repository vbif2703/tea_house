def create_admin():
    if ADMIN_LOGIN in users_db:
        return
    print("\nПервый запуск: придумайте пароль администратора чайного тауна.")
    while True:
        password = input("Пароль администратора: ").strip()
        repeat = input("Повторите пароль: ").strip()
        if len(password) < 4:
            print("Пароль должен быть не короче 4 символов.")
            continue
        if password != repeat:
            print("Пароли не совпадают.")
            continue
        break
    users_db[ADMIN_LOGIN] = {"password_hash": hash_password(password), "balance": 50000}
    save_user(ADMIN_LOGIN)
    print("Администратор создан. В базе сохранен только хеш пароля.")


def add_user():
    print("\n--- Создание новой учетной записи ---")
    user_login = input("Введи имя пользователя: ").strip()
    if not user_login or ";" in user_login:
        print("Некорректное имя.")
        return
    if user_login in users_db:
        print("Такой гость уже зарегистрирован!")
        return
    user_password = input("Введи пароль для учетной записи: ").strip()
    if len(user_password) < 4:
        print("Пароль должен быть не короче 4 символов.")
        return
    users_db[user_login] = {"password_hash": hash_password(user_password), "balance": 0}
    save_user(user_login)
    print("Учетная запись успешно создана!")


