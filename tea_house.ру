def generate_receipt_id():
    while True:
        receipt_id = f"TEA-{int(time.time())}-{random.randint(100000, 999999)}"
        if not fetch_all("SELECT id FROM orders WHERE id = ?", (receipt_id,)):
            return receipt_id


def save_receipt(login, receipt_id, content):
    execute("INSERT INTO receipts (id, login, content) VALUES (?, ?, ?)", (receipt_id, login, content))
    with open(f"{login}{RECEIPT_SUFFIX}", "a", encoding="utf-8") as file:
        file.write(content + "\n---\n")


def get_receipts(login):
    return [row[0] for row in fetch_all("SELECT content FROM receipts WHERE login = ? ORDER BY rowid", (login,))]


def timer(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        start_time = time.time()
        result = func(*args, **kwargs)
        return result, round(time.time() - start_time, 4)
    return wrapper


def check_login(func):
    @wraps(func)
    def wrapper(login, *args, **kwargs):
        if login not in users_db:
            print(f"Пользователь '{login}' не найден в базе данных.")
            return None
        return func(login, *args, **kwargs)
    return wrapper


def admin_only(func):
    @wraps(func)
    def wrapper(login, *args, **kwargs):
        if login != ADMIN_LOGIN or login not in users_db:
            print("Доступ запрещен: нужны права администратора.")
            return None
        return func(login, *args, **kwargs)
    return wrapper


def place_order(login, section, item, qty, price, hall, minutes, unit):
    total = price * qty
    if not can_make(stock, item, qty):
        print("Сейчас этого нет в наличии: закончились ингредиенты. Выбери другую позицию.")
        return
    if users_db[login]["balance"] < total:
        print(f"Недостаточно денег. Нужно {total} руб., у вас {users_db[login]['balance']} руб.")
        return
    users_db[login]["balance"] -= total
    save_user(login)
    consume(stock, item, qty)
    save_stock()
    order = {"id": generate_receipt_id(), "user": login, "section": section, "item": item,
             "qty": qty, "price": total, "hall": hall, "minutes": minutes,
             "ready_time": time.time() + minutes * MINUTE_LENGTH}
    active_orders.append(order)
    add_order_to_database(order)
    print(f"Принято. Номер: {order['id']}")
    if section == CEREMONY_SECTION:
        print(f"Церемония '{item}', зал '{hall}', гостей: {qty}, длительность {minutes} мин.")
        print("Зал занят до конца церемонии, другие залы можно бронировать параллельно.")
    else:
        print(f"{item}: {qty} x {price} руб. / {unit}. Итого {total} руб.")
        print(f"Готовность через {minutes} мин.")
    print(f"Остаток на балансе: {users_db[login]['balance']} руб.")


def buy_goods(login):
    selected = choose_item()
    if not selected:
        return
    section, item, price, unit, minutes = selected
    qty = ask_int(f"Сколько взять ({unit})? ", 1, 50)
    if qty is None:
        return
    place_order(login, section, item, qty, price, "", minutes, unit)


def book_ceremony(login):
    selected = choose_ceremony()
    if not selected:
        return
    item, price, minutes = selected
    guests = ask_int("Сколько гостей? ", 1, max(HALLS.values()))
    if guests is None:
        return
    busy = busy_halls()
    available = [hall for hall, capacity in HALLS.items() if capacity >= guests and hall not in busy]
    if not available:
        print("Свободных залов под такое количество гостей сейчас нет.")
        show_halls()
        return
    print("\nСвободные залы:")
    for number, hall in enumerate(available, start=1):
        print(f"{number}. {hall} (до {HALLS[hall]} гостей)")
    choice = ask_int("Выбери зал: ", 1, len(available))
    if choice is None:
        return
    hall = available[choice - 1]
    print(f"Цена {price} руб. за гостя, всего {price * guests} руб., длительность {minutes} мин.")
    if input("Подтвердить бронь? (y/n): ").strip().lower() != "y":
        print("Бронь отменена.")
        return
    place_order(login, CEREMONY_SECTION, item, guests, price, hall, minutes, "гость")


@timer
def process_orders_logic():
    current_time = time.time()
    completed = []
    for order in list(active_orders):
        if current_time >= order["ready_time"]:
            active_orders.remove(order)
            execute("UPDATE orders SET status = 'done' WHERE id = ?", (order["id"],))
            completed.append(order)
    return completed


