def execute(query, params=()):
    db = sqlite3.connect(DB_FILE)
    try:
        db.execute(query, params)
        db.commit()
    finally:
        db.close()


def execute_many(query, rows):
    db = sqlite3.connect(DB_FILE)
    try:
        db.executemany(query, rows)
        db.commit()
    finally:
        db.close()


def fetch_all(query, params=()):
    db = sqlite3.connect(DB_FILE)
    try:
        return db.execute(query, params).fetchall()
    finally:
        db.close()


def init_database():
    execute("CREATE TABLE IF NOT EXISTS users (login TEXT PRIMARY KEY, password_hash TEXT NOT NULL, balance INTEGER NOT NULL)")
    execute("CREATE TABLE IF NOT EXISTS menu (section TEXT NOT NULL, item TEXT NOT NULL, price INTEGER NOT NULL, unit TEXT NOT NULL, minutes INTEGER NOT NULL, PRIMARY KEY (section, item))")
    execute("CREATE TABLE IF NOT EXISTS orders (id TEXT PRIMARY KEY, login TEXT NOT NULL, section TEXT NOT NULL, item TEXT NOT NULL, qty INTEGER NOT NULL, price INTEGER NOT NULL, hall TEXT NOT NULL, minutes INTEGER NOT NULL, ready_at REAL NOT NULL, status TEXT NOT NULL)")
    execute("CREATE TABLE IF NOT EXISTS receipts (id TEXT PRIMARY KEY, login TEXT NOT NULL, content TEXT NOT NULL)")
    execute("CREATE TABLE IF NOT EXISTS ingredients (name TEXT PRIMARY KEY, amount INTEGER NOT NULL, minimum INTEGER NOT NULL)")


def load_database():
    global users_db
    users_db = {login: {"password_hash": ph, "balance": balance}
                for login, ph, balance in fetch_all("SELECT login, password_hash, balance FROM users")}


def save_user(login):
    data = users_db[login]
    execute("INSERT OR REPLACE INTO users (login, password_hash, balance) VALUES (?, ?, ?)",
            (login, data["password_hash"], data["balance"]))


def load_menu():
    global tea_menu
    tea_menu = {}
    for section, item, price, unit, minutes in fetch_all("SELECT section, item, price, unit, minutes FROM menu"):
        tea_menu.setdefault(section, {})[item] = (price, unit, minutes)
    if not tea_menu:
        tea_menu = {section: items.copy() for section, items in default_menu.items()}
    for section, items in tea_menu.items():
        for item, (price, unit, minutes) in list(items.items()):
            if unit == "порция":
                items[item] = (price, "100 г", minutes)
    save_menu()


def save_menu():
    execute("DELETE FROM menu")
    rows = [(section, item, price, unit, minutes)
            for section, items in tea_menu.items()
            for item, (price, unit, minutes) in items.items()]
    execute_many("INSERT INTO menu (section, item, price, unit, minutes) VALUES (?, ?, ?, ?, ?)", rows)


def load_stock():
    global stock
    stock = {name: (amount, minimum)
             for name, amount, minimum in fetch_all("SELECT name, amount, minimum FROM ingredients")}
    for name, value in default_stock().items():
        stock.setdefault(name, value)
    save_stock()


def save_stock():
    execute("DELETE FROM ingredients")
    execute_many("INSERT INTO ingredients (name, amount, minimum) VALUES (?, ?, ?)",
                 [(name, amount, minimum) for name, (amount, minimum) in stock.items()])


def ask_int(prompt, low, high):
    try:
        value = int(input(prompt))
    except ValueError:
        print("Нужно ввести число.")
        return None
    if not low <= value <= high:
        print(f"Допустимо от {low} до {high}.")
        return None
    return value


def visible_items(section, reveal=False):
    items = tea_menu.get(section, {})
    if reveal:
        return list(items.items())
    return [(item, data) for item, data in items.items() if can_make(stock, item, 1)]


def show_sections():
    print("\n-------- РАЗДЕЛЫ МЕНЮ --------")
    for number, section in enumerate(tea_menu, start=1):
        print(f"{number}. {section} ({len(tea_menu[section])} поз.)")


def show_section_items(section, reveal=False):
    rows = visible_items(section, reveal)
    print(f"\n--- {section.upper()} ---")
    if not rows:
        print("Нет доступных позиций.")
        return
    for number, (item, (price, unit, minutes)) in enumerate(rows, start=1):
        print(f"{number}. {item} - {price} руб. / {unit} ({minutes} мин)")
        if reveal and composition(item):
            print(f"   состав: {composition(item)}")


def show_full_menu(reveal=False):
    if not tea_menu:
        print("Меню пустое.")
        return
    shown = 0
    for section in tea_menu:
        rows = visible_items(section, reveal)
        if rows:
            show_section_items(section, reveal)
            shown += len(rows)
    print(f"\nДоступно позиций: {shown}")


def pick_section(reveal=False):
    sections = [section for section in tea_menu if visible_items(section, reveal)]
    if not sections:
        print("Сейчас нет доступных разделов.")
        return None
    print("\n-------- РАЗДЕЛЫ МЕНЮ --------")
    for number, section in enumerate(sections, start=1):
        print(f"{number}. {section} ({len(visible_items(section, reveal))} поз.)")
    print("0. Назад")
    choice = input("Выбери раздел: ").strip()
    if choice == "0":
        return None
    if choice.isdigit() and 1 <= int(choice) <= len(sections):
        return sections[int(choice) - 1]
    print("Такого раздела нет.")
    return None


def choose_item():
    while True:
        section = pick_section()
        if not section:
            return None
        if section == CEREMONY_SECTION:
            print("Церемонии бронируются отдельным пунктом меню.")
            continue
        while True:
            rows = visible_items(section)
            show_section_items(section)
            print("0. Назад к разделам")
            choice = input("Выбери позицию: ").strip()
            if choice == "0":
                break
            if choice.isdigit() and 1 <= int(choice) <= len(rows):
                item, (price, unit, minutes) = rows[int(choice) - 1]
                return section, item, price, unit, minutes
            print("Такой позиции нет в разделе.")


def choose_ceremony():
    items = tea_menu.get(CEREMONY_SECTION, {})
    if not items:
        print("Церемоний сейчас нет в меню.")
        return None
    show_section_items(CEREMONY_SECTION)
    print("0. Назад")
    choice = input("Выбери церемонию: ").strip()
    if choice == "0":
        return None
    names = list(items)
    if choice.isdigit() and 1 <= int(choice) <= len(names):
        item = names[int(choice) - 1]
        price, unit, minutes = items[item]
        return item, price, minutes
    print("Такой церемонии нет.")
    return None


