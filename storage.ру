def default_stock():
    totals = {}
    for recipe in RECIPES.values():
        for name, amount in recipe.items():
            totals[name] = totals.get(name, 0) + amount
    return {name: (total * 20, total * 5) for name, total in totals.items()}


def composition(item):
    return ", ".join(RECIPES.get(item, {}))


def can_make(stock, item, qty=1):
    for name, amount in RECIPES.get(item, {}).items():
        if stock.get(name, (0, 0))[0] < amount * qty:
            return False
    return True


def consume(stock, item, qty=1):
    for name, amount in RECIPES.get(item, {}).items():
        current, minimum = stock[name]
        stock[name] = (current - amount * qty, minimum)


def shortages(stock):
    return [(name, amount, minimum) for name, (amount, minimum) in stock.items() if amount <= minimum]


def blocked_items(stock, menu):
    result = []
    for section, items in menu.items():
        for item in items:
            if item in RECIPES and not can_make(stock, item, 1):
                missing = [name for name, amount in RECIPES[item].items()
                           if stock.get(name, (0, 0))[0] < amount]
                result.append((section, item, missing))
    return result
